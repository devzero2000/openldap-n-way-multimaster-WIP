# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # Mappatura dei nodi con i rispettivi IP
  nodes = {
    "ubuntu24lts1" => "192.168.1.16",
    "ubuntu24lts2" => "192.168.1.17",
    "ubuntu24lts3" => "192.168.1.18",
    "ubuntu24lts4" => "192.168.1.19"
  }

  nodes.each_with_index do |(hostname, ip), index|
    config.vm.define hostname do |node|
      
      node.vm.hostname = "#{hostname}.example.com"
      node.vm.provider "vmware_desktop" do |v|
        v.gui = false
        v.vmx["memsize"] = "4096"
        v.vmx["numvcpus"] = "2"
        # Niente sincronizzazione PERIODICA dell'orologio da VMware Tools:
        # l'ora la gestisce solo il servizio NTP, che su 24.04 e' il default
        # systemd-timesyncd (chrony non e' installato). Con entrambi attivi
        # l'orologio delle VM oscillava di ~4,5s (VMware Tools lo riportava
        # all'ora dell'host, l'NTP all'ora NTP): orologi dei master sfasati
        # di secondi -> CSN fuori ordine -> divergenza permanente sui
        # conflitti MMR (Scenario B di test_concurrent_multimaster_write.yml,
        # 2026-10-26, VM 26.04 con chrony). systemd-timesyncd tiene i nodi a
        # decine di ms l'uno dall'altro: sufficiente, i test tollerano fino a
        # 250ms. Le sincronizzazioni una tantum (resume/snapshot) restano
        # attive.
        v.vmx["tools.syncTime"] = "FALSE"
      end

      # Rete Bridged
      node.vm.network "public_network", ip: ip, bridge: "eth0"

      # Provisioning iniziale (eseguito solo alla prima creazione)
      node.vm.provision "shell", inline: <<-SHELL
        export DEBIAN_FRONTEND=noninteractive

        # --- FIX IPv6 / mirror APT (diagnosticato in sessione di lavoro,
        # settembre 2026): il router di casa non fornisce IPv6 (ne' RA ne'
        # DHCPv6 rispondono - verificato fino in fondo alla catena: Windows
        # configurato correttamente, VMware con IPv6 abilitato, router muto).
        # Senza questo fix, qualunque comando apt che risolva un host con
        # record AAAA (com'era us.archive.ubuntu.com/security.ubuntu.com di
        # default) resta bloccato fino al timeout prima di ripiegare su
        # IPv4 - capitato concretamente gia' su questo stesso apt-get update
        # qui sotto, alla primissima creazione della VM. Applicato PRIMA di
        # qualunque altra cosa, cosi' anche questo primo apt-get ne
        # beneficia, non solo i provisioning successivi.
        sysctl -w net.ipv6.conf.all.disable_ipv6=1
        sysctl -w net.ipv6.conf.default.disable_ipv6=1
        cat << 'EOF' > /etc/sysctl.d/99-disable-ipv6.conf
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF

        cat << 'EOF' > /etc/apt/sources.list.d/ubuntu.sources
Types: deb
URIs: http://ubuntu.mirror.garr.it/ubuntu-archive/
Suites: noble noble-updates noble-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: http://ubuntu.mirror.garr.it/ubuntu-archive/
Suites: noble-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF
        # --- fine fix IPv6 / mirror APT ---

        timedatectl set-timezone Europe/Rome
        timedatectl set-ntp true
        systemctl restart systemd-timesyncd
        
        echo "vagrant ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-vagrant
        chmod 440 /etc/sudoers.d/90-vagrant

        if [ ! -f /home/vagrant/.ssh/id_rsa ]; then
          sudo -u vagrant ssh-keygen -t rsa -N "" -f /home/vagrant/.ssh/id_rsa
        fi

        mkdir -p /vagrant/.cluster_keys
        cp /home/vagrant/.ssh/id_rsa.pub /vagrant/.cluster_keys/#{hostname}.pub
        chown vagrant:vagrant /vagrant/.cluster_keys/#{hostname}.pub

        apt-get update -y
        apt-get install -y software-properties-common
        apt-add-repository --yes --update ppa:ansible/ansible
        apt-get install -y ansible

        # Aggiornamento completo dei pacchetti (resta su 24.04: le suite sono
        # fissate su noble) + pulizia di quelli non piu' necessari.
        # force-confdef/confold: nessun prompt sui file di configurazione
        # modificati (si tiene la versione locale); NEEDRESTART_MODE=a evita
        # il prompt di needrestart sui servizi da riavviare.
        export NEEDRESTART_MODE=a
        apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" full-upgrade
        apt-get autoremove -y --purge
        apt-get autoclean -y
      SHELL
    end
  end

  # Secondo stage / Boot provisioning: eseguito SEMPRE ad ogni avvio (run: "always") 
  nodes.each do |hostname, ip|
    config.vm.define hostname do |node|
      node.vm.provision "shell", run: "always", inline: <<-SHELL
        export DEBIAN_FRONTEND=noninteractive

        # 0) Niente sincronizzazione PERIODICA dell'orologio da VMware Tools,
        #    a ogni avvio (non solo alla creazione): affianca
        #    v.vmx["tools.syncTime"] = "FALSE" e vale anche per le VM gia'
        #    esistenti. L'ora la gestisce solo il servizio NTP. Con entrambi
        #    attivi gli orologi dei master oscillavano di ~4,5s e i CSN finivano
        #    fuori ordine (vedi description_test_concurrent_multimaster_write.md).
        if command -v vmware-toolbox-cmd >/dev/null 2>&1; then
          vmware-toolbox-cmd timesync disable
          echo "VMware Tools timesync: $(vmware-toolbox-cmd timesync status)"
        else
          echo "vmware-toolbox-cmd non presente: timesync di VMware Tools non modificato" >&2
        fi

        # 1) Configurazione hosts
        sed -i '/# Configurazione Cluster Ansible/,$d' /etc/hosts
        echo -e "\n# Configurazione Cluster Ansible" >> /etc/hosts
        echo "192.168.1.16 ubuntu24lts1.example.com ubuntu24lts1" >> /etc/hosts
        echo "192.168.1.17 ubuntu24lts2.example.com ubuntu24lts2" >> /etc/hosts
        echo "192.168.1.18 ubuntu24lts3.example.com ubuntu24lts3" >> /etc/hosts
        echo "192.168.1.19 ubuntu24lts4.example.com ubuntu24lts4" >> /etc/hosts
        # Nuovo cluster Ubuntu 26.04
        echo "192.168.1.20 ubuntu26lts1.example.com ubuntu26lts1" >> /etc/hosts
        echo "192.168.1.21 ubuntu26lts2.example.com ubuntu26lts2" >> /etc/hosts
        echo "192.168.1.22 ubuntu26lts3.example.com ubuntu26lts3" >> /etc/hosts
        echo "192.168.1.23 ubuntu26lts4.example.com ubuntu26lts4" >> /etc/hosts

        # 2) Inventory Ansible
        mkdir -p /etc/ansible
        cat << 'EOF' > /etc/ansible/hosts
[cluster]
ubuntu24lts1.example.com
ubuntu24lts2.example.com
ubuntu24lts3.example.com

[readonlyreplica]
ubuntu24lts4.example.com

[ldap_all:children]
cluster
readonlyreplica
EOF

        # 3) Unattended Upgrades & Configurazione completa
        apt-get update -y
        apt-get install -y unattended-upgrades apt-listchanges

        cat << 'EOF' > /etc/apt/apt.conf.d/20auto-upgrades
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

        cat << 'EOF' > /etc/apt/apt.conf.d/50unattended-upgrades-local
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-updates";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}";
    "${distro_id}ESM:${distro_codename}";
};
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Clean-Installed-Packages "true";
EOF

        # FORZA L'AGGIORNAMENTO TOTALE E LA PULIZIA AD OGNI AVVIO
        # (resta su 24.04: le suite sono fissate su noble)
        export NEEDRESTART_MODE=a
        apt-get update -y
        apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" full-upgrade
        apt-get autoremove -y --purge
        apt-get autoclean -y

        # 4) Gestione chiavi SSH (APPEND invece di SOVRASCRITTURA)
        if [ -d /vagrant/.cluster_keys ]; then
          cat /vagrant/.cluster_keys/*.pub >> /home/vagrant/.ssh/authorized_keys
          sort -u /home/vagrant/.ssh/authorized_keys -o /home/vagrant/.ssh/authorized_keys
          chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
          chmod 600 /home/vagrant/.ssh/authorized_keys
        fi

        # Configurazione SSH: blocco gestito tra marcatori, riscritto a ogni
        # avvio senza toccare il resto del file. Prima il file veniva
        # sovrascritto con ">", cancellando ogni aggiunta manuale (es. il
        # blocco Host github.com, sparito -> git push "Permission denied").
        SSH_CFG=/home/vagrant/.ssh/config
        BEGIN_MARK="# BEGIN cluster Vagrant (gestito dal provisioning, non modificare)"
        END_MARK="# END cluster Vagrant"
        touch "$SSH_CFG"
        # Migrazione: file scritto per intero dalla vecchia versione (nessun
        # marcatore e solo le vecchie righe) -> si riparte da file vuoto
        if ! grep -qF "$BEGIN_MARK" "$SSH_CFG" && \
           ! grep -qvxF -e 'Host 192.168.1.*' -e 'Host *.example.com' \
               -e '  StrictHostKeyChecking no' -e '  UserKnownHostsFile=/dev/null' -e '' "$SSH_CFG"; then
          : > "$SSH_CFG"
        fi
        sed -i "/^$BEGIN_MARK/,/^$END_MARK/d" "$SSH_CFG"
        {
          echo "$BEGIN_MARK"
          echo "Host 192.168.1.*"
          echo "  StrictHostKeyChecking no"
          echo "  UserKnownHostsFile=/dev/null"
          echo "Host *.example.com"
          echo "  StrictHostKeyChecking no"
          echo "  UserKnownHostsFile=/dev/null"
          # Chiave per GitHub (solo sui nodi dove e' presente)
          if [ -f /home/vagrant/.ssh/id_ed25519_github ]; then
            echo "Host github.com"
            echo "  IdentityFile ~/.ssh/id_ed25519_github"
            echo "  IdentitiesOnly yes"
          fi
          # Chiave per GitLab (fork di OpenLDAP; solo dove e' presente)
          if [ -f /home/vagrant/.ssh/id_ed25519_gitlab ]; then
            echo "Host gitlab.com"
            echo "  IdentityFile ~/.ssh/id_ed25519_gitlab"
            echo "  IdentitiesOnly yes"
          fi
          echo "$END_MARK"
        } >> "$SSH_CFG"
        chown vagrant:vagrant "$SSH_CFG"
        chmod 600 "$SSH_CFG"
      SHELL
    end
  end
end
