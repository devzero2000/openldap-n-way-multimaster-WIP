# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-26.04"
  config.vm.box_version = "202606.01.0"
  # Versione della box fissata: inutile interrogare Vagrant Cloud a ogni
  # "vagrant up" per sapere se ne esiste una piu' recente.
  config.vm.box_check_update = false

  domain = "example.com"

  # Mappatura dei nodi con i rispettivi IP
  nodes = {
    "ubuntu26lts1" => "192.168.1.20",
    "ubuntu26lts2" => "192.168.1.21",
    "ubuntu26lts3" => "192.168.1.22",
    "ubuntu26lts4" => "192.168.1.23"
  }

  # Nodo di controllo Ansible: unico nodo con Ansible installato.
  # Ansible si usa come utente "vagrant" (come nel cluster 24.04).
  master = "ubuntu26lts1"

  # Repliche in sola lettura (gruppo [readonlyreplica] dell'inventory);
  # tutti gli altri nodi finiscono nel gruppo [cluster].
  readonly_replicas = ["ubuntu26lts4"]

  # /etc/hosts e inventory Ansible generati da "nodes": un solo punto in cui
  # aggiungere/rinominare nodi, niente liste duplicate da tenere allineate.
  hosts_block = nodes.map { |h, ip| "#{ip} #{h}.#{domain} #{h}" }.join("\n")
  cluster_nodes = nodes.keys - readonly_replicas
  inventory = [
    "[cluster]",
    *cluster_nodes.map { |h| "#{h}.#{domain}" },
    "",
    "[readonlyreplica]",
    *readonly_replicas.map { |h| "#{h}.#{domain}" },
    "",
    "[ldap_all:children]",
    "cluster",
    "readonlyreplica",
    "",
    "[all:vars]",
    "ansible_user=vagrant",
    "ansible_python_interpreter=/usr/bin/python3"
  ].join("\n")

  nodes.each do |hostname, ip|
    config.vm.define hostname do |node|

      node.vm.hostname = "#{hostname}.#{domain}"
      node.vm.provider "vmware_desktop" do |v|
        v.gui = false
        v.vmx["memsize"] = "4096"
        v.vmx["numvcpus"] = "2"
        # Slot PCI delle schede di rete presenti nel VMX del box bento:
        # dichiarati esplicitamente come richiesto dal warning di Vagrant
        # (vmx-allowlisting), cosi' la rete resta configurata correttamente
        # anche quando Vagrant smettera' di sovrascriverli.
        v.vmx["ethernet0.pcislotnumber"] = "160"
        v.vmx["ethernet1.pcislotnumber"] = "256"
        # Valori gia' dichiarati qui sopra: il warning di Vagrant sul VMX
        # della box (vmx-allowlisting) non aggiunge informazioni.
        # :disable_warning e non true: non e' la box a essere stata corretta,
        # e' questo Vagrantfile a compensare.
        v.allowlist_verified = :disable_warning
        # Niente sincronizzazione PERIODICA dell'orologio da VMware Tools:
        # l'ora la gestisce solo chrony (NTP). Con entrambi attivi l'orologio
        # delle VM oscillava di ~4,5s (VMware Tools lo riportava all'ora
        # dell'host, chrony all'ora NTP) e il kernel finiva con frequenze
        # assurde (tick 9000 = -10% su una VM): orologi dei master sfasati
        # di secondi -> CSN fuori ordine -> divergenza permanente sui
        # conflitti MMR (Scenario B di test_concurrent_multimaster_write.yml,
        # 2026-10-26). Le sincronizzazioni una tantum (resume/snapshot)
        # restano attive.
        v.vmx["tools.syncTime"] = "FALSE"
        # Linked clone (default): il disco della VM dipende dal disco base
        # nella cache delle box (~/.vagrant.d/boxes). Cancellare la box rende
        # la VM non avviabile (incidente del 2026-11-23). Con false ogni VM
        # nuova ha un disco completo e autonomo, al costo di piu' spazio.
        # Vale solo per le VM create dopo la modifica.
        # v.linked_clone = false
      end

      # Rete Bridged
      node.vm.network "public_network", ip: ip, bridge: "eth0"

      # ------------------------------------------------------------------
      # Provisioning iniziale "setup": eseguito solo alla prima creazione
      # (o esplicitamente con: vagrant provision --provision-with setup).
      # Contiene tutto cio' che e' lento (apt) o che serve una volta sola.
      # ------------------------------------------------------------------
      node.vm.provision "setup", type: "shell", inline: <<-SHELL
        set -e
        export DEBIAN_FRONTEND=noninteractive
        export NEEDRESTART_MODE=a
        # Al primo boot apt-daily/unattended-upgrades possono partire da soli
        # e tenere il lock di dpkg: invece di fallire con "Could not get
        # lock", apt aspetta fino a 10 minuti che il lock si liberi.
        APT_OPTS="-o DPkg::Lock::Timeout=600"

        # --- FIX IPv6 / mirror APT (diagnosticato in sessione di lavoro,
        # settembre 2026): il router di casa non fornisce IPv6 (ne' RA ne'
        # DHCPv6 rispondono - verificato fino in fondo alla catena: Windows
        # configurato correttamente, VMware con IPv6 abilitato, router muto).
        # Senza questo fix, qualunque comando apt che risolva un host con
        # record AAAA (com'era us.archive.ubuntu.com/security.ubuntu.com di
        # default) resta bloccato fino al timeout prima di ripiegare su
        # IPv4 - capitato concretamente gia' su questo stesso apt-get update
        # qui sotto, alla primissima creazione della VM. Applicato PRIMA di
        # qualunque altra cosa, cosi' anche questo primo apt-get ne
        # beneficia, non solo i provisioning successivi.
        sysctl -w net.ipv6.conf.all.disable_ipv6=1
        sysctl -w net.ipv6.conf.default.disable_ipv6=1
        cat << 'EOF' > /etc/sysctl.d/99-disable-ipv6.conf
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF

        # Ubuntu 26.04 LTS = codename "resolute" (era "noble" su 24.04)
        cat << 'EOF' > /etc/apt/sources.list.d/ubuntu.sources
Types: deb
URIs: http://ubuntu.mirror.garr.it/ubuntu-archive/
Suites: resolute resolute-updates resolute-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: http://ubuntu.mirror.garr.it/ubuntu-archive/
Suites: resolute-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF
        # --- fine fix IPv6 / mirror APT ---

        # Aggiornamento completo dei pacchetti + pulizia di quelli non piu'
        # necessari (es. kernel vecchi). Una volta sola, alla creazione: gli
        # aggiornamenti successivi li fa unattended-upgrades (sotto).
        # force-confdef/confold: nessun prompt sui file di configurazione
        # modificati (si tiene la versione locale); NEEDRESTART_MODE=a evita
        # il prompt di needrestart sui servizi da riavviare.
        apt-get $APT_OPTS update
        apt-get $APT_OPTS -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" full-upgrade
        apt-get $APT_OPTS install -y unattended-upgrades
        apt-get $APT_OPTS autoremove -y --purge
        apt-get $APT_OPTS autoclean -y

        # --- Aggiornamenti automatici (unattended-upgrades) ---
        cat << 'EOF' > /etc/apt/apt.conf.d/20auto-upgrades
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF

        # Sostituisce il vecchio 50unattended-upgrades-local, che indicava le
        # origini ESM senza suffisso del pocket (non corrispondevano a nessun
        # repository). Le liste Allowed-Origins si SOMMANO a quelle di
        # 50unattended-upgrades (che gia' include security ed ESM security):
        # qui si aggiungono esplicitamente anche gli "updates".
        rm -f /etc/apt/apt.conf.d/50unattended-upgrades-local
        cat << 'EOF' > /etc/apt/apt.conf.d/52unattended-upgrades-local
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-updates";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESMApps:${distro_codename}-apps-updates";
    "${distro_id}ESM:${distro_codename}-infra-security";
    "${distro_id}ESM:${distro_codename}-infra-updates";
};
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
// Nessun riavvio automatico: nel cluster MMR i nodi non devono riavviarsi
// tutti insieme. Dopo un aggiornamento del kernel il riavvio va fatto a
// mano, un nodo alla volta (presenza di /var/run/reboot-required).
Unattended-Upgrade::Automatic-Reboot "false";
EOF
        # --- fine aggiornamenti automatici ---

        timedatectl set-timezone Europe/Rome
        # Su 26.04 il servizio NTP e' chrony (systemd-timesyncd non e'
        # installato: il vecchio "systemctl restart systemd-timesyncd",
        # ereditato dal Vagrantfile 24.04, falliva con "Unit not found").
        # timedatectl set-ntp abilita chrony tramite
        # /usr/lib/systemd/ntp-units.d/50-chrony.list.
        timedatectl set-ntp true
        systemctl restart chrony

        echo "vagrant ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-vagrant
        chmod 440 /etc/sudoers.d/90-vagrant

        if [ ! -f /home/vagrant/.ssh/id_rsa ]; then
          sudo -u vagrant ssh-keygen -t rsa -N "" -f /home/vagrant/.ssh/id_rsa
        fi

        mkdir -p /vagrant/.cluster_keys
        cp /home/vagrant/.ssh/id_rsa.pub /vagrant/.cluster_keys/#{hostname}.pub
        chown vagrant:vagrant /vagrant/.cluster_keys/#{hostname}.pub

        # --- Solo sul master: Ansible e strumenti di sviluppo ---
        if [ "#{hostname}" = "#{master}" ]; then
          # Ansible dai repository ufficiali di Ubuntu 26.04 (universe).
          # Il PPA ppa:ansible/ansible non pubblica pacchetti per "resolute"
          # (verificato settembre 2026: ultime build per questing/noble):
          # aggiungerlo farebbe fallire apt-add-repository e il provisioning.
          # (apt-get update gia' eseguito all'inizio del provisioning)
          apt-get $APT_OPTS install -y ansible

          # Strumenti di sviluppo Ansible (tutti da universe di 26.04):
          # - ansible-lint: lint dei playbook; "ansible-lint --fix" fa anche
          #   da reformatter dei file YAML nello stile atteso da ansible-lint
          # - yamllint: verifica sintassi e stile YAML
          # - vim + vim-ale: lint in tempo reale dentro Vim (ALE si carica da
          #   solo da /usr/share/vim/vimfiles/pack/dist-bundle/start/ale)
          apt-get $APT_OPTS install -y ansible-lint yamllint vim vim-ale

          # Configurazione yamllint compatibile con ansible-lint
          # (letta da yamllint e da ansible-lint quando il progetto non ha
          # un proprio file .yamllint)
          install -d -m 755 -o vagrant -g vagrant /home/vagrant/.config /home/vagrant/.config/yamllint
          cat << 'EOF' > /home/vagrant/.config/yamllint/config
extends: default

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
  line-length:
    max: 160
    level: warning
EOF
          chown vagrant:vagrant /home/vagrant/.config/yamllint/config

          # Configurazione Vim di sistema per YAML/Ansible
          # (/etc/vim/vimrc.local viene letto da /etc/vim/vimrc su Ubuntu)
          cat << 'EOF' > /etc/vim/vimrc.local
" --- YAML / Ansible ---
filetype plugin indent on
syntax on
set encoding=utf-8

augroup ansible_yaml
  autocmd!
  " File Ansible riconosciuti dal percorso -> filetype yaml.ansible
  " (ALE lancia sia yamllint sia ansible-lint)
  autocmd BufRead,BufNewFile */playbooks/*.yml,*/playbooks/*.yaml set filetype=yaml.ansible
  autocmd BufRead,BufNewFile */roles/*.yml,*/roles/*.yaml set filetype=yaml.ansible
  autocmd BufRead,BufNewFile */group_vars/*,*/host_vars/* set filetype=yaml.ansible
  autocmd BufRead,BufNewFile site.yml,site.yaml,playbook*.yml,playbook*.yaml set filetype=yaml.ansible
  " Indentazione YAML: 2 spazi, mai tab
  autocmd FileType yaml,yaml.ansible setlocal tabstop=2 softtabstop=2 shiftwidth=2 expandtab autoindent
  " Colonna del cursore e caratteri invisibili per vedere l'indentazione
  autocmd FileType yaml,yaml.ansible setlocal cursorcolumn list listchars=tab:>-,trail:-
augroup END

" ALE: quali linter usare e quando
let g:ale_linters = {'yaml': ['yamllint'], 'ansible': ['ansible_lint']}
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 0
let g:ale_lint_on_enter = 1
let g:ale_lint_on_save = 1
let g:ale_sign_column_always = 1

" :AnsibleFix -> salva, riformatta/corregge con ansible-lint --fix e ricarica
command! AnsibleFix write | execute '!ansible-lint --fix ' . shellescape(expand('%')) | edit!
EOF
        fi
      SHELL

      # ------------------------------------------------------------------
      # Provisioning "boot": eseguito SEMPRE ad ogni avvio (run: "always").
      # Solo operazioni locali e istantanee (niente apt, niente rete):
      # l'avvio delle VM resta rapido e non entra in conflitto con
      # unattended-upgrades per il lock di dpkg.
      # ------------------------------------------------------------------
      node.vm.provision "boot", type: "shell", run: "always", inline: <<-SHELL
        # 0) Niente sincronizzazione PERIODICA dell'orologio da VMware Tools,
        #    a ogni avvio (non solo alla creazione): affianca
        #    v.vmx["tools.syncTime"] = "FALSE" e vale anche per le VM gia'
        #    esistenti. L'ora la gestisce solo il servizio NTP. Con entrambi
        #    attivi gli orologi dei master oscillavano di ~4,5s e i CSN finivano
        #    fuori ordine (vedi description_test_concurrent_multimaster_write.md).
        if command -v vmware-toolbox-cmd >/dev/null 2>&1; then
          vmware-toolbox-cmd timesync disable
          echo "VMware Tools timesync: $(vmware-toolbox-cmd timesync status)"
        else
          echo "vmware-toolbox-cmd non presente: timesync di VMware Tools non modificato" >&2
        fi

        # 1) Configurazione hosts (generata dalla mappa "nodes")
        sed -i '/# Configurazione Cluster Ansible/,$d' /etc/hosts
        cat << 'EOF' >> /etc/hosts

# Configurazione Cluster Ansible
#{hosts_block}
EOF

        # 2) Inventory Ansible (solo sul master, generato dalla mappa "nodes")
        if [ "#{hostname}" = "#{master}" ]; then
          mkdir -p /etc/ansible
          cat << 'EOF' > /etc/ansible/hosts
#{inventory}
EOF
        fi

        # 3) Gestione chiavi SSH (APPEND invece di SOVRASCRITTURA)
        if [ -d /vagrant/.cluster_keys ]; then
          cat /vagrant/.cluster_keys/*.pub >> /home/vagrant/.ssh/authorized_keys
          sort -u /home/vagrant/.ssh/authorized_keys -o /home/vagrant/.ssh/authorized_keys
          chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
          chmod 600 /home/vagrant/.ssh/authorized_keys
        fi

        # 4) Configurazione SSH client tra i nodi del cluster
        cat << 'EOF' > /home/vagrant/.ssh/config
Host 192.168.1.*
  StrictHostKeyChecking no
  UserKnownHostsFile=/dev/null
Host *.#{domain}
  StrictHostKeyChecking no
  UserKnownHostsFile=/dev/null
EOF
        chown vagrant:vagrant /home/vagrant/.ssh/config
        chmod 600 /home/vagrant/.ssh/config
      SHELL
    end
  end
end
